# Vercel Build Ignore
# Files and directories to exclude from Vercel builds

# Development
node_modules
*.log
.git
.vscode
.idea

# Documentation
README.md
SETUP.md
DEPLOYMENT.md
FREE_DEPLOYMENT.md
POSTMAN_GUIDE.md
claudedocs

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
tests/
__tests__/

# Database
*.db
*.db-journal
prisma/migrations/

# Environment
.env.example
.env.vercel.example
