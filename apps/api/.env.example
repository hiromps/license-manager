# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/license_manager

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# License Signing (Ed25519 Keys - Generate with crypto package)
LICENSE_PUBLIC_KEY=base64-encoded-public-key
LICENSE_PRIVATE_KEY=base64-encoded-private-key

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# CORS
CORS_ORIGIN=http://localhost:5173
