# Vercel Production Environment Variables Template
# Copy these to Vercel Dashboard → Settings → Environment Variables

# Database (Neon Free Tier)
DATABASE_URL=postgresql://username:password@ep-xxx-xxx.region.neon.tech/dbname?sslmode=require

# JWT Configuration
JWT_SECRET=change-this-to-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=24h

# License Signing Keys (Generate with: node scripts/generate-keys.js)
LICENSE_PRIVATE_KEY=your-base64-encoded-private-key-here
LICENSE_PUBLIC_KEY=your-base64-encoded-public-key-here

# Application Settings
NODE_ENV=production
CORS_ORIGIN=https://your-app.vercel.app

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Optional: Redis (Not needed for free tier)
# REDIS_URL=redis://...
